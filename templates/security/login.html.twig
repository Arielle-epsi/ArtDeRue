{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1>Connexion</h1>

    {% if error %}
        <p style="color: red;">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    {% if app.user %}
        <p>Tu es connecté en tant que {{ app.user.userIdentifier }}.
            <a href="{{ path('app_logout') }}">Se déconnecter</a></p>
    {% else %}
        <form method="post">
            <p>
                <label for="username">Email</label><br>
                <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
            </p>
            <p>
                <label for="password">Mot de passe</label><br>
                <input type="password" id="password" name="_password" required>
            </p>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>
    {% endif %}
{% endblock %}