{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1>Les artistes</h1>

    <ul>
        {% for artiste in artistes %}
            <li>
                <strong><a href="{{ path('app_artistes_show', {id: artiste.id}) }}">{{ artiste.pseudonyme }}</a></strong>
                {% if artiste.nomReel %}({{ artiste.nomReel }}){% endif %}
                : {{ artiste.nationalite }}
            </li>
        {% endfor %}
    </ul>
{% endblock %}